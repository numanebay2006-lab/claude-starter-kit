{%- assign code = section.settings.code | default: 'TREAT10' -%}
<section class="pp-section pp-section--khaki pp-game-sec" id="pp-game">
  <div class="pp-wrap">
    <div class="pp-game" data-pp-game data-code="{{ code | escape }}" data-goal="{{ section.settings.goal }}" data-seconds="{{ section.settings.seconds }}">
      <div class="pp-game__head">
        <p class="pp-eyebrow">Mini game</p>
        <h2 class="pp-h2">{{ section.settings.heading }}</h2>
        <p class="pp-lead">Catch {{ section.settings.goal }} treats in {{ section.settings.seconds }} seconds and win <b>{{ section.settings.percent }}% off</b>. It stacks with bundle savings.</p>
      </div>

      <div class="pp-game__board" data-board aria-label="Treat Drill game area" tabindex="-1">
        <div class="pp-game__hud" aria-hidden="true">
          <span>🦴 <b data-score>0</b> / {{ section.settings.goal }}</span>
          <span>⏱ <b data-time>{{ section.settings.seconds }}</b>s</span>
        </div>
        <div class="pp-game__player" data-player>{% render 'pp-mascot' %}</div>

        <div class="pp-game__screen" data-screen="intro">
          <p class="pp-game__title">Treat Drill</p>
          <p>Move Sergeant Pup left and right to catch the falling bones. Golden bones count double.</p>
          <p class="pp-game__keys">Drag or tap on phones. Arrow keys on a computer.</p>
          <button type="button" class="pp-btn" data-start>Start the drill</button>
        </div>
        <div class="pp-game__screen" data-screen="lose" hidden>
          <p class="pp-game__title">Good effort, recruit!</p>
          <p>You caught <b data-final>0</b>. Try again?</p>
          <button type="button" class="pp-btn" data-start>Try again</button>
          <button type="button" class="pp-link pp-game__skip" data-skip>Skip the drill, show my code</button>
        </div>
        <div class="pp-game__screen pp-game__screen--win" data-screen="win" hidden>
          <p class="pp-game__title">Drill complete! 🎖️</p>
          <p>You unlocked <b>{{ section.settings.percent }}% off</b>. One use per customer, orders from $35.</p>
          <div class="pp-game__code"><span>{{ code }}</span><button type="button" class="pp-btn pp-btn--sm pp-btn--ghost" data-copy>Copy</button></div>
          <button type="button" class="pp-btn" data-apply>Apply code to my cart</button>
          <p class="pp-game__msg" data-msg aria-live="polite"></p>
        </div>
      </div>
      <p class="pp-game__note">Not into games? That's fine. The game never blocks buying, and your cart is always one tap away.</p>
      <p class="pp-sr" data-live aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  .pp-game { max-width: 760px; margin: 0 auto; }
  .pp-game__head { text-align: center; margin-bottom: 20px; }
  .pp-game__head .pp-lead { margin-inline: auto; }
  .pp-game__board { position: relative; height: 360px; border-radius: var(--pp-r-lg); overflow: hidden; touch-action: none; user-select: none; -webkit-user-select: none;
    background: radial-gradient(circle at 20% 30%, rgba(75,93,42,.18) 0 60px, transparent 61px), radial-gradient(circle at 80% 60%, rgba(122,106,63,.18) 0 70px, transparent 71px), radial-gradient(circle at 50% 90%, rgba(75,93,42,.16) 0 80px, transparent 81px), #F6EEDB;
    border: 3px solid var(--pp-olive); box-shadow: inset 0 -40px 0 rgba(75,93,42,.12); }
  @media (min-width: 750px) { .pp-game__board { height: 400px; } }
  .pp-game__hud { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; z-index: 3; font-weight: 700; }
  .pp-game__hud span { background: var(--pp-surface); border: 2px solid var(--pp-ink); border-radius: 999px; padding: 4px 12px; box-shadow: 2px 2px 0 var(--pp-ink); }
  .pp-game__player { position: absolute; left: 0; bottom: 4px; width: 78px; z-index: 2; will-change: transform; }
  .pp-game__player .pp-mascot { width: 78px; }
  .pp-game__treat { position: absolute; top: 0; left: 0; width: 34px; height: 34px; z-index: 1; will-change: transform; pointer-events: none; }
  .pp-game__treat svg { width: 100%; height: 100%; }
  .pp-game__pop { position: absolute; z-index: 4; font: 400 20px/1 var(--pp-display); color: var(--pp-success); pointer-events: none; animation: pp-pop .7s ease-out forwards; }
  @keyframes pp-pop { to { transform: translateY(-40px); opacity: 0; } }
  .pp-game__screen { position: absolute; inset: 0; z-index: 5; display: grid; place-content: center; justify-items: center; gap: 10px; text-align: center; padding: 20px; background: rgba(251,246,236,.94); }
  .pp-game__screen p { margin: 0; max-width: 40ch; }
  .pp-game__title { font: 400 30px/1.1 var(--pp-display); }
  .pp-game__keys { font-size: 13px; color: var(--pp-muted); }
  .pp-game__skip { background: none; border: 0; cursor: pointer; font: inherit; font-size: 14px; color: var(--pp-ink); padding: 8px; }
  .pp-game__code { display: flex; align-items: center; gap: 10px; background: var(--pp-surface); border: 2px dashed var(--pp-olive); border-radius: 14px; padding: 8px 8px 8px 16px; }
  .pp-game__code span { font: 400 26px/1 var(--pp-stamp); letter-spacing: .08em; }
  .pp-game__msg { font-weight: 700; color: var(--pp-success); min-height: 1.4em; }
  .pp-game__note { text-align: center; font-size: 13px; color: var(--pp-muted); margin: 12px 0 0; }
</style>
<script src="{{ 'pp-game.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PP Treat Drill game",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Play Treat Drill, win 10% off" },
    { "type": "text", "id": "code", "label": "Discount code (must exist in Discounts)", "default": "TREAT10" },
    { "type": "number", "id": "percent", "label": "Discount percent shown", "default": 10 },
    { "type": "number", "id": "goal", "label": "Treats to win", "default": 10 },
    { "type": "number", "id": "seconds", "label": "Seconds", "default": 15 }
  ],
  "presets": [{ "name": "PP Treat Drill game" }]
}
{% endschema %}

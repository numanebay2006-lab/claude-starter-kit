{%- capture truck -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{%- endcapture -%}
<div class="pp-announce" data-pp-announce>
  <div class="pp-announce__track" aria-live="off">
    {%- assign shown = 0 -%}
    {%- for i in (1..3) -%}
      {%- assign key = 'announce_' | append: i -%}
      {%- assign text = section.settings[key] -%}
      {%- if text != blank -%}
        <p class="pp-announce__msg" {% if shown > 0 %}aria-hidden="true"{% endif %} style="margin:0">{{ truck }}<span>{{ text }}</span></p>
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>


{% schema %}
{
  "name": "PP Announcement bar",
  "settings": [
    { "type": "text", "id": "announce_1", "label": "Announcement 1", "default": "Free shipping on every order · Arrives in 5–7 business days" },
    { "type": "text", "id": "announce_2", "label": "Announcement 2", "default": "Need it sooner? Express shipping is only $2.55" },
    { "type": "text", "id": "announce_3", "label": "Announcement 3", "default": "Buy 2, save 15% · Buy 3+, save 25%" }
  ]
}
{% endschema %}

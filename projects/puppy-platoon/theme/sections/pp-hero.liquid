{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = all_products['puppy-soldier-clothes-suit']
  endif
  assign img = section.settings.image | default: p.featured_media
-%}
{%- capture check -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L19 7"/></svg>{%- endcapture -%}
{{ 'pp-home.css' | asset_url | stylesheet_tag }}
<section class="pp-hero pp-camo">
  <div class="pp-wrap pp-hero__grid">
    <div class="pp-hero__media">
      {{ img | image_url: width: 1400 | image_tag: widths: '450, 700, 900, 1200, 1400', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: 'Dachshund wearing the Puppy Platoon soldier costume with helmet, vest and plush toy rifle' }}
      <span class="pp-hero__badge" aria-hidden="true"><span>Free<small>shipping</small></span></span>
      <div class="pp-hero__mascot">
        {% render 'pp-mascot', label: 'Sergeant Pup, tap for a salute' %}
        {%- capture lines -%}["Ten-hut! This suit turns dogs into tiny soldiers.","Plush arms up front. Your pup looks like it's standing guard.","The rifle is a soft plush toy. Not a real or replica weapon.","Free shipping. Arrives in 5–7 business days.","I salute on command. Tap me!"]{%- endcapture -%}
        <p class="pp-bubble-say" data-pp-lines="{{ lines | escape }}" aria-live="off">Ten-hut! This suit turns dogs into tiny soldiers.</p>
      </div>
    </div>
    <div class="pp-hero__copy">
      <p class="pp-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="pp-h1">{{ section.settings.heading }}</h1>
      <p class="pp-lead">{{ section.settings.text }}</p>
      <div class="pp-hero__price">
        <b>{{ p.price | money }}</b>
        <span class="pp-tag pp-tag--olive">Free shipping</span>
        <a href="#bundles" class="pp-link" style="font-size:14px">Save up to 20% with bundles</a>
      </div>
      {%- if p.available -%}
        <a href="{{ p.url }}" class="pp-btn pp-btn--block" data-pp-hero-cta data-pp-cta="hero">{{ section.settings.button }} · {{ p.price | money }}</a>
      {%- else -%}
        <span class="pp-btn pp-btn--block" aria-disabled="true">Sold out</span>
      {%- endif -%}
      <a href="#size-finder" class="pp-hero__alt pp-link">Not sure of the size? Find it in 10 seconds →</a>
      <ul class="pp-checks">
        <li>{{ check }}Free shipping, 5–7 days</li>
        <li>{{ check }}Express 3–5 days $3</li>
        <li>{{ check }}30-day returns</li>
      </ul>
    </div>
  </div>
</section>

{%- if p.available -%}
<div class="pp-homebar" data-pp-home-sticky inert>
  {{ p.featured_image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', width: 48, height: 48 }}
  <div><b>{{ p.price | money }}</b>Free shipping · 5–7 days</div>
  <a href="{{ p.url }}" class="pp-btn" data-pp-cta="homebar">Shop Now</a>
</div>
{%- endif -%}

{% schema %}
{
  "name": "PP Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image (blank = product photo)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dog costume · Sizes S–2XL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Turn your dog into a tiny soldier." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A camo costume with a helmet, headset, vest and plush arms that hold a soft toy rifle. From the front, your pup looks like it's standing on duty." },
    { "type": "text", "id": "button", "label": "Button", "default": "Enlist My Dog" }
  ],
  "presets": [{ "name": "PP Hero" }]
}
{% endschema %}
